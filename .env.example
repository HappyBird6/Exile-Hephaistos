# Local development only. Copy to .env and replace the password placeholder.
# Keep this name stable after initializing a database.
POSTGRES_VOLUME_NAME=exile-hephaistos_postgres-data
POSTGRES_DB=poe2craft
POSTGRES_USER=poe2craft
POSTGRES_PASSWORD=replace-with-local-password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/poe2craft
SPRING_DATASOURCE_USERNAME=poe2craft
SPRING_DATASOURCE_PASSWORD=replace-with-local-password
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
APP_PUBLIC_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Reserved for future integrations. AI remains disabled in this scaffold.
OPENAI_API_KEY=
OPENAI_MODEL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
POE_NINJA_USER_AGENT=
# One optional administrator. Both blank disables admin APIs.
# Username: 3-64 ASCII letters/digits/_.-; password: 16-128 chars, upper/lower/digit,
# without username, "password", "replace", or control characters. Never commit real values.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_CRAWL_ENABLED=false
# Secure is the default. Set false only for local HTTP development.
APP_SESSION_COOKIE_SECURE=true
# Host execution: export PYTHONPATH=<absolute repo>/data-pipeline/src.
# Docker already supplies Python and these paths.
APP_CRAWL_PYTHON=python
APP_CRAWL_DIRECTORY=../data-pipeline/captures

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "supported-base-sets-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "uniqueItems": true
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ruleset-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rulesetVersion",
    "gameSeason",
    "gamePatch",
    "provenance",
    "engineRuleVersion",
    "ledgerVersion",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rulesetVersion": {
      "type": "string",
      "minLength": 1
    },
    "gameSeason": {
      "type": "string",
      "minLength": 1
    },
    "gamePatch": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "engineRuleVersion": {
      "type": "string",
      "minLength": 1
    },
    "ledgerVersion": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^(catalog|crafting)/[a-zA-Z0-9_./-]+\\.json$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "goal-bases-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "bases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "pool"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "pool": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    }
  }
}
